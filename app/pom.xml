<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>it.ramasql</groupId>
    <artifactId>ramasql-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>ramasql-app</artifactId>
  <name>RamaSQL :: app (interfaccia Swing)</name>
  <dependencies>
    <dependency><groupId>it.ramasql</groupId><artifactId>ramasql-core</artifactId></dependency>
    <dependency><groupId>it.ramasql</groupId><artifactId>ramasql-model</artifactId></dependency>
    <dependency><groupId>it.ramasql</groupId><artifactId>ramasql-sqleo-qb</artifactId></dependency>
    <dependency><groupId>com.formdev</groupId><artifactId>flatlaf</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- I test non devono MAI scrivere nella vera %APPDATA%\RamaSQL: cartella dei dati deviata sotto target/ -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ramasql.appdata>${project.build.directory}/appdata-test</ramasql.appdata>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>it.ramasql.app.Main</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>it.ramasql.app.Main</mainClass>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
